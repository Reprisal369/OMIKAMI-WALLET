# PUBLIC identifiers only.
# NEVER put private keys, seed phrases, mnemonics, or any secret in any env file.
# This application has no server; every value here ends up in the public bundle.

# WalletConnect (Reown) project ID — a PUBLIC identifier, not a secret.
# Obtain it yourself from the official Reown/WalletConnect dashboard.
# Leave unset: the app runs injected-wallets-only (current phase-one default).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
